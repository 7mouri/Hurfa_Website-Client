{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hurfa-customizer-local",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "hurfa-customizer-local", "database_id": "local-only", "migrations_dir": "drizzle" }],
  "r2_buckets": [{ "binding": "MATERIAL_ASSETS", "bucket_name": "hurfa-materials-local" }]
}
